# Copy to ~/.hedge-fund/.env (or a .env in your working directory). The app
# also prompts for missing keys on first run and writes them there for you.
# Keys exported in your shell always win over these files.

# For getting financial data to power the hedge fund
# Get your Financial Datasets API key from https://financialdatasets.ai/
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key

# One LLM API key is enough — set the provider you plan to use.

# For running LLMs hosted by Anthropic (Opus, Sonnet, Haiku)
# Get your Anthropic API key from https://anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# For running LLMs hosted by OpenAI (GPT 5, etc.)
# Get your OpenAI API key from https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key

# For running LLMs hosted by DeepSeek (deepseek-chat, deepseek-reasoner)
# Get your DeepSeek API key from https://deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key

# For running LLMs hosted by Google (gemini-2.5-flash, gemini-2.5-pro)
# Get your Google API key from https://ai.dev/
GOOGLE_API_KEY=your-google-api-key

# For running LLMs hosted by xAI (Grok 4, etc.)
XAI_API_KEY=your-xai-api-key

# For running LLMs hosted by Moonshot / Kimi (kimi-k2, kimi-latest)
# Get your Moonshot API key from https://platform.moonshot.ai/
# Mainland China users: set MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_API_KEY=your-moonshot-api-key

# ---------------------------------------------------------------------------
# 飞书多维表格（早盘选股 / 晚间复盘 记录用）
# 自建应用凭证在飞书开放平台「凭证与基础信息」获取；
# 应用需开通 bitable:app 权限，并添加为表格协作者（可编辑）。
# APP_TOKEN 即表格的 app_token（bascn 开头），可在表格「文档信息」查看，
# 或用 hedge_fund/strategies/feishu_migrate.py 自动反查。
# TABLE_ID 为表格 URL 中 table= 后的那段（如 tblwjeAx1Y4IQysJ）。
# ---------------------------------------------------------------------------
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_APP_TOKEN=your-feishu-app-token
FEISHU_TABLE_ID=your-feishu-table-id

# ---------------------------------------------------------------------------
# 企业微信（群机器人 Webhook）— 早盘研报 / 复盘 / 异动 / 持仓总结 的广播推送
# 在企微「群聊 → 添加群机器人」获取 Webhook 地址。仅用于【发送】，不能收消息。
# ---------------------------------------------------------------------------
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key

# ---------------------------------------------------------------------------
# 企业微信【自建应用】— 用于【接收】用户发来的持仓截图并分析（群机器人无法收消息）
# 在企微管理后台「应用管理 → 自建 → 创建应用」获取 corp_id / agent_id / secret，
# 并在应用里配置「接收消息」回调 URL（指向 wx_bot_server.py 运行地址 + /wx/callback），
# 回调的 Token 与 EncodingAESKey 在此填写。
# ---------------------------------------------------------------------------
# ⚠️ 启用「企微自建应用接收持仓截图」必须补齐以下 4 项（当前仍缺）：
#   1) WX_CORP_ID        —— 企业 ID（企微管理后台「我的企业 → 企业信息」获取）。【你尚未提供】
#   2) WX_CORP_SECRET    —— 自建应用 Secret（应用 → 查看 Secret 复制后填此处）。
#   3) WX_TOKEN          —— 你自定义的回调 Token（与企微后台「接收消息」设置一致，任意字符串）。
#   4) WX_AES_KEY        —— 43 位 EncodingAESKey（企微后台「接收消息」设置里生成）。
#   外加：wx_bot_server.py 需公网可达（云服务器公网IP/域名，或 ngrok 内网穿透），
#        回调 URL 填 https://<公网地址>/wx/callback，端口见 WX_BOT_PORT。
WX_CORP_ID=your-corp-id
# 你提供的自建应用 AgentId 为 1000002（直接填好）：
WX_AGENT_ID=1000002
# 自建应用 Secret（应用 → 查看 Secret 复制后填此处）：
WX_CORP_SECRET=your-corp-secret
WX_TOKEN=your-callback-token
WX_AES_KEY=your-43char-encodingaeskey
WX_BOT_HOST=0.0.0.0
WX_BOT_PORT=8080

# ---------------------------------------------------------------------------
# 视觉 OCR（持仓截图识别）— 用【多模态大模型】从券商 App 截图提取 代码/数量/价格
#   重要：这里不是百度/腾讯那种独立 OCR 服务，而是能"看懂图片"的视觉大模型，
#   所以 VISION_API_KEY 就是某个【支持图像输入】的 LLM 的 API Key。任选其一：
#
#   A. 通义千问 VL（国内最稳，中文 UI 识别强，推荐国内用户）✅
#      申请：阿里云百炼控制台 https://bailian.console.aliyun.com → API Key 管理 → 创建
#      填写：VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
#            VISION_MODEL=qwen3-vl-plus   （或 qwen-vl-max）
#            VISION_API_KEY=你的 DASHSCOPE_API_KEY
#
#   B. Kimi / Moonshot（原生视觉理解，100 万 token 上下文）✅
#      申请：https://platform.moonshot.cn → API Key 管理
#      填写：VISION_API_BASE=https://api.moonshot.cn/v1
#            VISION_MODEL=kimi-k3.1-pro   （或 kimi-k2.6）
#            VISION_API_KEY=你的 MOONSHOT_API_KEY
#
#   C. OpenAI（识别质量最高，但需海外网络）✅
#      申请：https://platform.openai.com → API keys
#      填写：VISION_API_BASE=https://api.openai.com/v1
#            VISION_MODEL=gpt-4o
#            VISION_API_KEY=你的 OPENAI_API_KEY
#
#   三选一即可；不单独填 VISION_API_KEY 时，会自动回退用上方 OPENAI_API_KEY。
#
#   D. 本地视觉模型（【不耗 token、零 API 费用】，耗你自己机器算力）✅
#      适合不想花 API 钱的场景。本代码接口是 OpenAI 兼容的，本地跑一个
#      支持视觉的模型（Ollama 等）即可直接对接，无需任何 API Key。
#      安装： https://ollama.com →  ollama pull <模型>  → 服务默认 http://localhost:11434
#      Mac mini 部署建议（识别中文持仓页更准的视觉模型，二选一）：
#        ollama pull qwen2.5vl        # 通义视觉，中文 OCR 强（若你介意"通义"可换下款）
#        ollama pull minicpm-v:8b     # MiniCPM-V，OCR/中文强、体积小
#      （llama3.2-vision 中文偏弱，仅应急；7B~8B 视觉模型建议机器 ≥16GB 内存）
#      填写：VISION_API_BASE=http://127.0.0.1:11434/v1
#            VISION_MODEL=qwen2.5vl    （或 minicpm-v:8b / llama3.2-vision）
#            VISION_API_KEY=sk-no-key-needed   （本地留占位即可，不校验）
#
#   E. 暂时免费（Mac mini 到位前的过渡）— 以下服务【OpenAI 兼容】，只改三行即可：
#      • SiliconFlow 硅基流动（国内友好，注册送免费额度）：
#          VISION_API_BASE=https://api.siliconflow.cn/v1
#          VISION_MODEL=THUDM/glm-4v-9b   （智谱·非千问；或 deepseek-ai/deepseek-vl2 / InternVL）
#          VISION_API_KEY=你的 SiliconFlow Key
#      • OpenRouter（全球，有真·免费视觉模型）：
#          VISION_API_BASE=https://openrouter.ai/api/v1
#          VISION_MODEL=google/gemini-2.0-flash-001   （免费档；或 meta-llama/llama-3.2-11b-vision-instruct）
#          VISION_API_KEY=你的 OpenRouter Key
#      • GitHub Models（免费、限流）：
#          VISION_API_BASE=https://models.inference.ai.azure.com
#          VISION_MODEL=gpt-4o   （GitHub 免费额度；或 gpt-4o-mini）
#          VISION_API_KEY=你的 GitHub Token
#      ⚠️ 免费档通常有速率/额度限制且可能过期，长期仍建议方案 D（本地 Mac mini）。
#
#   🔛 一键切换：设置 VISION_BACKEND 即可自动套用上面的 base/默认模型，只需再填对应 Key：
#      VISION_BACKEND=openai | siliconflow | openrouter | github | ollama
#      （视觉 OCR 与持仓文本分析共用此后端；ollama 为本地免费、不耗 token）
# ---------------------------------------------------------------------------
VISION_BACKEND=openai
VISION_API_KEY=your-vision-key
VISION_API_BASE=https://api.openai.com/v1
VISION_MODEL=gpt-4o
# 各免费后端对应的 Key 变量（VISION_BACKEND 命中时自动读取，无需逐个填）：
SILICONFLOW_API_KEY=your-siliconflow-key
OPENROUTER_API_KEY=your-openrouter-key
GITHUB_TOKEN=your-github-token

# ---------------------------------------------------------------------------
# 持仓分析 & 自动进化 Skill
# ---------------------------------------------------------------------------
HOLDINGS_FILE=my_holdings.json          # 解析后的持仓持久化文件
EXPERIENCE_FILE=skills_memory.json      # 经验记忆（自动进化 Skill 的知识库）
SKILL_AUTO_EVOLVE=true                 # 是否根据复盘结果自动沉淀经验、降低误判

# ---------------------------------------------------------------------------
# 稳健型模式（默认开启）：右侧交易 + 重视资金 + 控风险
#   在「保留原 8 大策略信号」基础上叠加硬性护栏，提高胜率、降低回撤。
#   你的偏好：稳健型，以右侧交易为主、重视资金面，可接受少利润但避免高风险。
# ---------------------------------------------------------------------------
STEADY_MODE=true                       # 稳健模式总开关（false 则退回原 8 策略纯信号）
STEADY_MIN_FLOAT_MCAP=5e9              # 最小流通市值（元），默认 50 亿，剔除小盘妖股
STEADY_MAX_PCT_60D=40                  # 60 日涨幅上限(%)，避免追入已大幅拉升的标的
STEADY_MAX_PE=80                       # 估值护栏：PE(TTM) 上限（亏损股放行并标注）

# ---------------------------------------------------------------------------
# 本地持仓录入页（方案 A：未认证企业免域名/备案；文字优先，绕开视觉 OCR）
#   用法：python hedge_fund/strategies/holding_upload_server.py
#   浏览器打开 http://127.0.0.1:8899 → 文本框粘贴「代码 数量 单价」→ 分析并推企微群。
#   文字录入【完全绕开视觉模型】，格式极简、顺序无关；截图录入仍保留为可选。
#   异动自动提醒：交易时段每 5 分钟扫描持仓，命中异动阈值即推企微群。
#   前提：本页复用「群机器人 webhook(WECHAT_WEBHOOK)」输出，无需企微自建应用/域名/备案。
# ---------------------------------------------------------------------------
WX_UPLOAD_HOST=127.0.0.1                # 仅本机访问；若需局域网其他设备访问改 0.0.0.0
WX_UPLOAD_PORT=8899                     # 本地上传页端口（与 wx_bot_server 的 8080 区分）
HOLDING_COUNCIL=true                   # 持仓分析是否附「多空议会」结论（看多/看空/大市/风控 交锋）
HOLDING_FILE=my_holdings.json           # 解析后的持仓持久化文件（未录入新数据前一直沿用）

# ---------------------------------------------------------------------------
# 视觉 OCR / 持仓分析 的 Token 与字数 控制（免费额度 / 本地模型都更省）
# ---------------------------------------------------------------------------
VISION_MAX_IMAGE_SIDE=1280             # 截图最长边压缩到此像素 → 大幅减少视觉 token
VISION_MAX_TOKENS=900                  # 视觉识别(持仓OCR)输出 token 上限
ANALYSIS_LLM_MAX_TOKENS=600            # 文本分析输出 token 上限
SUMMARY_MAX_CHARS=100000               # 单只持仓总结字数软上限（防刷屏/耗 token）

# ---------------------------------------------------------------------------
# 可选：Dify 后端（把持仓分析走 Dify 的免费模型，由 Dify 侧控额度/字数）
#   仅在配置 DIFY_API_KEY 且设 DIFY_ENABLED=true 时启用；否则走本地/直连 LLM。
#   说明：你曾考虑把 Dify 控制权交给我——本代码已预留该后端，启用即生效。
# ---------------------------------------------------------------------------
DIFY_ENABLED=false

# ---------------------------------------------------------------------------
# 多 Agent 议会 · 中肯决策引擎（看多操盘手 / 看空操盘手 / 大市观察员 / 风险风控官）
#   设计：四个 Agent 先各自独立开仓观点 → 多空互相驳论交锋 → 风险风控官规则化【终裁】
#         （一票否决 + 仓位上限），产出中肯报告而非单边买卖指令。
#   复用：stock_analyzer 多维数据 + holding_analyzer 的免费后端 LLM；三个行情节点不动。
#   降级：无 LLM Key 时自动走规则/模板，照样产出报告，主流程不中断。
#   开关：COUNCIL_ENABLED 控制早盘 top 候选；EVENING_COUNCIL 控制晚间逐只持仓。
#   推送呈现：议会采用 council_brief（紧凑且含多空双方辩论+交锋+风控终裁），
#            早盘把议会置于「多维分析」之前并收紧长度，确保两者同处一条消息不拆段。
# ---------------------------------------------------------------------------
COUNCIL_ENABLED=true                  # 早盘精选：对 top N 候选附议会中肯报告（含多空交锋）
COUNCIL_MAX_STOCKS=5                  # 早盘议会只覆盖前 N 只候选（控长度/省 token）
EVENING_COUNCIL=true                  # 晚间复盘：逐只持仓附议会中肯结论（多空辩论+风控终裁）
EVENING_ANALYSIS=true                 # 晚间复盘：逐只持仓补「多维分析（财报/盘面/资金面/消息面）」
COUNCIL_MAX_TOKENS=320                # 每个 Agent 短评 token 上限（省额度）
COUNCIL_LLM_TIMEOUT=40                # 议会单次 LLM 调用超时(秒)
DIFY_API_URL=https://api.dify.ai/v1/chat-messages
DIFY_API_KEY=your-dify-key
DIFY_USER=hedge-fund-bot

