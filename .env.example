# Copy to ~/.hedge-fund/.env (or a .env in your working directory). The app
# also prompts for missing keys on first run and writes them there for you.
# Keys exported in your shell always win over these files.

# For getting financial data to power the hedge fund
# Get your Financial Datasets API key from https://financialdatasets.ai/
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key

# One LLM API key is enough — set the provider you plan to use.

# For running LLMs hosted by Anthropic (Opus, Sonnet, Haiku)
# Get your Anthropic API key from https://anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# For running LLMs hosted by OpenAI (GPT 5, etc.)
# Get your OpenAI API key from https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key

# For running LLMs hosted by DeepSeek (deepseek-chat, deepseek-reasoner)
# Get your DeepSeek API key from https://deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key

# For running LLMs hosted by Google (gemini-2.5-flash, gemini-2.5-pro)
# Get your Google API key from https://ai.dev/
GOOGLE_API_KEY=your-google-api-key

# For running LLMs hosted by xAI (Grok 4, etc.)
XAI_API_KEY=your-xai-api-key

# For running LLMs hosted by Moonshot / Kimi (kimi-k2, kimi-latest)
# Get your Moonshot API key from https://platform.moonshot.ai/
# Mainland China users: set MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_API_KEY=your-moonshot-api-key

# ---------------------------------------------------------------------------
# 飞书多维表格（早盘选股 / 晚间复盘 记录用）
# 自建应用凭证在飞书开放平台「凭证与基础信息」获取；
# 应用需开通 bitable:app 权限，并添加为表格协作者（可编辑）。
# APP_TOKEN 即表格的 app_token（bascn 开头），可在表格「文档信息」查看，
# 或用 hedge_fund/strategies/feishu_migrate.py 自动反查。
# TABLE_ID 为表格 URL 中 table= 后的那段（如 tblwjeAx1Y4IQysJ）。
# ---------------------------------------------------------------------------
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_APP_TOKEN=your-feishu-app-token
FEISHU_TABLE_ID=your-feishu-table-id
